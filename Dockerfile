# syntax=docker/dockerfile:1

ARG NODE_VERSION=24

# --- Build -------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    PNPM_CONFIG_STORE_DIR=/pnpm-store
# Keep in sync with "packageManager" in package.json.
RUN npm install --global pnpm@12.14.0

# pnpm-workspace.yaml holds install settings, openapi/ feeds the postinstall type generation.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY openapi ./openapi
RUN --mount=type=cache,id=pnpm,target=/pnpm-store \
    pnpm install --frozen-lockfile

# schema.d.ts was generated by postinstall above (.dockerignore keeps any local copy out).
COPY . .
RUN pnpm run build

# --- Runtime -----------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Standalone output already contains the server, its traced node_modules and static assets.
COPY --from=build --chown=node:node /app/.next/standalone ./

USER node
EXPOSE 3000
# Runtime configuration (read per request): API_BASE_URL (required), TELEGRAM_BOT_URL (optional).
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server.js"]
