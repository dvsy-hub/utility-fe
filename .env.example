# Copy to .env.local (git-ignored) for `pnpm dev`. In production set these as container/runtime
# environment variables — they are read per request, so one image serves every environment.
# Values are delivered to the browser: NEVER put the bot token or any other secret here.

# Backend base URL (no trailing slash, no /api suffix — endpoints live at /v1/...).
API_BASE_URL=https://dvsy-utility-backend-rk9l58-56f94b-13-140-149-47.sslip.io

# Optional: shown as "Open in Telegram" when the app is opened in a regular browser.
# Mini App direct link from @BotFather, e.g. https://t.me/<bot_username>/<app_short_name>
TELEGRAM_BOT_URL=

# Optional, development only (ignored unless NODE_ENV=development):
# a REAL Telegram.WebApp.initData string copied from a live Mini App session, so you can
# iterate in a desktop browser. The backend still verifies it and rejects it once expired.
DEV_INIT_DATA=
